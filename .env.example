# =====================================================================
# Alethea — dev environment defaults
# Copy to .env and fill in MISTRAL_API_KEY. Compose reads this file.
# =====================================================================

COMPOSE_PROJECT_NAME=alethea

# --- API ------------------------------------------------------------
API_PORT=8080
HOST=0.0.0.0
DEBUG=true

# Public origin of the web app (used in transactional email links).
BASE_URL=http://localhost:3000

# Comma-separated CORS allowed origins (browser-visible Origin headers).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# false for http://localhost dev; true behind Caddy/HTTPS.
COOKIE_SECURE=false

# CIDRs (or bare IPs) of reverse proxies whose X-Forwarded-For header we trust.
# LEAVE EMPTY for direct exposure (dev). Behind Caddy in compose, set to
# 127.0.0.1/32,::1/128,172.16.0.0/12 so XFF from the proxy is honored.
# Caddy MUST overwrite (not append to) the inbound XFF — its default behavior does.
TRUSTED_PROXIES=

# AI provider (Phase 0: mistral only. Phase 2 adds openai/anthropic/openrouter.)
AI_PROVIDER=mistral
MISTRAL_API_KEY=

# Phase 2 keys (left blank — set if you want auto-detect to pick them up)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # default; override e.g. openai/gpt-4o, google/gemini-2.0-flash-001

# To USE OpenRouter as the pooled provider, switch AI_PROVIDER=openrouter and
# set OPENROUTER_API_KEY above. Pricing is per-model; the API is OpenAI-
# compatible so all of the existing pipeline (vision, JSON mode, retries)
# works without code changes. Rate limits are higher than Mistral free tier.

# --- Scraper --------------------------------------------------------
# Inside docker-compose: API talks to the scraper via its service hostname.
# Outside compose (bare `make api`): override to http://localhost:5001 in your shell.
INSTAGRAM_SERVICE_URL=http://scraper-instagram:5001
SCRAPER_PORT=5001

# --- Web ------------------------------------------------------------
WEB_PORT=3000
# Vite reads this. Browser fetches the API on the host port mapping, so localhost is correct
# whether the API runs in compose or bare.
VITE_API_URL=http://localhost:8080

# --- Postgres (Phase 1+) --------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alethea
POSTGRES_USER=alethea
POSTGRES_PASSWORD=alethea_dev_change_me
DATABASE_URL=postgres://alethea:alethea_dev_change_me@postgres:5432/alethea?sslmode=disable

# --- Redis (Phase 2+) -----------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Search providers (Phase 2) -------------------------------------
# At least one needed for the pipeline to do real fact-checking; otherwise
# every claim returns "unverifiable — search unavailable". Brave is primary
# (cheaper), Tavily is the fallback.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# --- BYOK secret encryption (Phase 2) -------------------------------
# 32-byte base64 key sealing all user-supplied provider keys with AES-GCM.
# Generate with: openssl rand -base64 32
# LEAVE UNSET to disable BYOK entirely — /api/me/keys will return 503 and
# the pipeline runs pool-only. Set in production.
# BYOK_MASTER_KEY=

# Add for integration tests:
# TEST_REDIS_URL=redis://localhost:6379/1

# --- Rate-limit caps (Phase 1+) -------------------------------------
# Per-day /api/check limits per tier. Production defaults are tight; dev
# users iterating on the pipeline will want to crank anon way up.
# RATELIMIT_CHECK_ANON=3       # prod default; raise for dev e.g. 50
# RATELIMIT_CHECK_FREE=10
# RATELIMIT_CHECK_BYOK=1000
# RATELIMIT_CHECK_PLUS=100
# RATELIMIT_CHECK_ADMIN=10000

# --- Pipeline pacing (Phase 2) --------------------------------------
# Defaults below are tuned for Mistral FREE tier (~1 req/sec). The Mistral
# client already retries 429s with backoff, but firing many parallel calls
# wastes the retry budget. On a paid plan, OpenRouter, or with BYOK keys,
# raise both significantly. To DISABLE image analysis entirely, set
# MAX_MEDIA_ITEMS=1 and ignore the cost of one extra vision call.
# MAX_MEDIA_ITEMS=6        # max images analyzed per check
# MEDIA_CONCURRENCY=2      # max concurrent vision calls

# --- Stripe (Phase 5) -----------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS_MONTHLY=
# STRIPE_PRICE_PLUS_YEARLY=

# --- hCaptcha (Phase 1) ---------------------------------------------
# Leave HCAPTCHA_SECRET blank in dev to disable captcha entirely.
# HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Auth test DB (integration tests only) --------------------------
# When running `go test ./auth -run Integration`, point this at a
# DISPOSABLE database — tests TRUNCATE every table on each run.
# TEST_DATABASE_URL=postgres://alethea:alethea_dev_change_me@localhost:5432/alethea_test?sslmode=disable
