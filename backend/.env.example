# ===========================================
# FactChecker Backend Configuration
# ===========================================

# Server Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=false

# ===========================================
# AI Provider Configuration
# ===========================================
# Currently supported: mistral
# Future: openai, anthropic, ollama
AI_PROVIDER=mistral

# Mistral AI (required for now)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (future)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (future)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# External Services
# ===========================================

# Instagram scraping service (Python/Flask)
INSTAGRAM_SERVICE_URL=http://localhost:5001